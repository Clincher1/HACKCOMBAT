{
  "name": "hacker-kombat",
  "private": true,
  "version": "2.1.0",
  "description": "HACKER KOMBAT — Telegram Mini App Idle/Clicker Game (12+, fictional)",
  "scripts": {
    "prebuild": "node scripts/sync-assets.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build && node scripts/bundle-api.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "bot:setup": "node bot/setup-bot.mjs",
    "balance:sim": "npx esbuild scripts/balance-sim.ts --bundle --platform=node --format=cjs --outfile=/tmp/hk-sim.cjs --log-level=warning && node /tmp/hk-sim.cjs",
    "qa:api": "node scripts/qa/api.mjs",
    "qa:clicks": "node scripts/qa/clicks.mjs",
    "qa:offline": "node scripts/qa/offline-v32.mjs",
    "qa:integrity": "npx esbuild scripts/qa/integrity.ts --bundle --platform=node --format=cjs --outfile=/tmp/hk-integrity.cjs --log-level=warning && node /tmp/hk-integrity.cjs",
    "qa:all": "npm run build && npm run qa:integrity && npm run qa:offline && npm run qa:daily-incident && npm run qa:profile-frame-gifts && npm run qa:profile-inventory-gifts && npm run qa:buy && npm run qa:donate && npm run qa:referral && npm run qa:chips && npm run qa:daily && npm run qa:contracts && npm run qa:hacks && npm run qa:lollipop && npm run qa:season && npm run qa:mission-costs && npm run qa:pets && npm run qa:profile-frames && npm run qa:leaderboard && npm run qa:themes && npm run qa:cosmetics && npm run qa:backdrops && npm run qa:profile-inventory && npm run qa:funnel && npm run qa:onboarding && npm run qa:world && npm run qa:locations && npm run qa:retention && npm run qa:overlays && npm run qa:gameplay && npm run qa:economy && npm run qa:story && npm run qa:ui && npm run qa:inventory && npm run qa:bundle && npm run qa:release && npm run qa:wipe",
    "qa:buy": "node scripts/qa/buy-fast.mjs",
    "qa:donate": "node scripts/qa/donates.mjs",
    "qa:referral": "node scripts/qa/referral.mjs",
    "qa:chips": "node scripts/qa/chips.mjs",
    "qa:daily": "node scripts/qa/daily-tasks.mjs",
    "qa:contracts": "node scripts/qa/contracts.mjs",
    "qa:hacks": "node scripts/qa/hacks.mjs",
    "qa:lollipop": "node scripts/qa/lollipop.mjs",
    "qa:daily-incident": "node scripts/qa/daily-incident.mjs",
    "qa:profile-frame-gifts": "node scripts/qa/profile-frame-gifts.mjs",
    "qa:profile-inventory-gifts": "node scripts/qa/profile-inventory-gifts.mjs",
    "qa:season": "node scripts/qa/season-event.mjs",
    "qa:mission-costs": "node scripts/qa/mission-entry-costs.mjs",
    "qa:mission-costs:supabase": "node scripts/qa/mission-entry-costs-supabase.mjs",
    "qa:pets": "node scripts/qa/pets.mjs",
    "qa:profile-frames": "node scripts/qa/profile-frames.mjs",
    "qa:leaderboard": "node scripts/qa/leaderboard.mjs",
    "qa:themes": "node scripts/qa/themes.mjs",
    "qa:cosmetics": "node scripts/qa/cosmetics.mjs",
    "qa:backdrops": "node scripts/qa/backdrops.mjs",
    "qa:profile-inventory": "node scripts/qa/profile-inventory.mjs",
    "qa:funnel": "node scripts/qa/funnel.mjs",
    "qa:onboarding": "node scripts/qa/onboarding.mjs",
    "qa:world": "node scripts/qa/world.mjs",
    "qa:locations": "node scripts/qa/locations.mjs",
    "qa:retention": "node scripts/qa/retention.mjs",
    "qa:gameplay": "node scripts/qa/gameplay.mjs",
    "qa:economy": "node scripts/qa/economy.mjs",
    "qa:story": "node scripts/qa/story.mjs",
    "qa:ui": "node scripts/qa/ui.mjs",
    "qa:bundle": "node scripts/qa/bundle-budget.mjs",
    "qa:release": "node scripts/qa/release-branch.mjs",
    "qa:wipe": "node scripts/qa/wipe.mjs",
    "qa:inventory": "node scripts/qa/inventory.mjs",
    "wipe:players": "node scripts/wipe-players.mjs",
    "wipe:backup": "node scripts/wipe-players.mjs --backup-only",
    "qa:overlays": "npx esbuild scripts/qa/overlays.ts --bundle --platform=node --format=cjs --jsx=automatic --banner:js=\"$(cat scripts/qa/prelude.cjs)\" --outfile=/tmp/hk-overlays.cjs --log-level=warning && node /tmp/hk-overlays.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@telegram-apps/sdk-react": "^3.1.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "overrides": {
    "valibot": "1.5.0"
  }
}
