# ============================================================
# HACKER KOMBAT — Переменные окружения (.env.example)
# Никогда не коммитьте реальные секреты в Git!
# ============================================================

# 1. Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAExampleBotTokenFromBotFatherHere
# Необязательный секретный токен для верификации заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret_string

# Публичный URL задеплоенного приложения на Vercel (без слэша в конце)
PUBLIC_WEBAPP_URL=https://hacker-kombat.vercel.app

# 2. Supabase (Frontend — безопасный anon ключ, защищённый RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase (Backend / Vercel Serverless Functions — только сервер!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Бесплатная аналитика (необязательно — Umami Cloud Free / Self-host или Yandex Metrica)
# DEFAULT: подключаются автоматически в index.html, если указаны ID
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_YANDEX_METRICA_ID=
